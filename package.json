{
  "name": "dsh-usage",
  "version": "1.0.2",
  "description": "Non-official DSH account balance and model quota dashboard, derived from dougen/dsh-deepseek-usage.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types.d.ts",
  "icon": "./icon.svg",
  "scripts": {
    "check": "node --check lib/network.js && node --check lib/index.js && node --check lib/accounts.js && node --check lib/providers.js && node --check lib/pricing.js && node --check lib/adapters.js && node --check lib/routing.js && node --check lib/client.js",
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "screenshots.json",
    "VERSION",
    "RELEASE_NOTES.md",
    "SECURITY.md",
    "NOTICE.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "usage",
    "balance",
    "quota",
    "oauth",
    "tokens",
    "web"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAxium/dsh-usage.git"
  },
  "homepage": "https://github.com/AAxium/dsh-usage",
  "bugs": {
    "url": "https://github.com/AAxium/dsh-usage/issues"
  }
}
